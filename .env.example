# ── Identitas ─────────────────────────────
BOT_NAME=Nycore Bot
STORE_NAME=Nycore Studio
OWNER_NAME=Owner Nycore
OWNER_NUMBER=6281234567890
BOT_NUMBER=6281234567891
PREFIX=/
TIMEZONE=Asia/Jakarta

# ── Order Kuota API (QRIS via H2H OkeConnect) ─
ORDERKUOTA_BASE_URL=https://api.orderkuota.com/api/v2
ORDERKUOTA_API_KEY=
ORDERKUOTA_MERCHANT_ID=
ORDERKUOTA_SECRET_KEY=

# ── Webhook (callback notifikasi pembayaran real-time, opsional) ─
# PORT diisi OTOMATIS oleh Railway saat deploy, tidak perlu diisi manual.
# Untuk testing lokal boleh isi manual, contoh: PORT=3000
PORT=
WEBHOOK_PATH=/webhook/orderkuota
WEBHOOK_SECRET=

# ── Database ──────────────────────────────
DB_PATH=./database/database.db
